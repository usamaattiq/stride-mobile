# Google Maps JavaScript API + Geocoding API key for the location picker.
# Without it, the map sheet shows a fallback (current-location still works).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# stride-api base URL, including the /api prefix — must match stride-api's PORT
# (see its .env, default 4000, this repo's local instance may use a different port).
# On a physical device via Expo Go, `localhost` won't resolve — use your dev
# machine's LAN IP instead.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Hosted stride-compliance site (no trailing slash). Used for Privacy / Terms /
# Account Deletion links (App Store / Play Store + in-app). Local preview:
# http://localhost:8080 after `python3 -m http.server 8080` in stride-compliance.
EXPO_PUBLIC_COMPLIANCE_BASE_URL=https://compliance.musafir249.com

# Must match stride-api TRIP_CREATE_CREDITS (shown on the publish button).
EXPO_PUBLIC_TRIP_CREATE_CREDITS=10
