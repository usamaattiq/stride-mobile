# Public env vars are inlined into the JS bundle at `expo start`, EAS Build, and
# `eas update` time. Local `.env` is gitignored. Preview/production builds use
# the matching `env` block in eas.json. When publishing an OTA update, your
# local env (or EAS environment) must match that profile — do not publish a
# production update while pointing at localhost.

# Google Maps — one key per platform for native MapView (Maps SDK only).
# Injected via app.config.ts. Places/Geocoding use stride-api GOOGLE_MAPS_SERVER_API_KEY.
# Restrict Android key with package + SHA-1; iOS key with bundle ID.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=
# Optional legacy fallback if platform-specific keys are unset:
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# stride-api base URL, including the /api prefix — must match stride-api's PORT
# (see its .env, default 4000, this repo's local instance may use a different port).
# On a physical device via Expo Go, `localhost` won't resolve — use your dev
# machine's LAN IP instead.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Hosted stride-compliance site (no trailing slash). Used for Privacy / Terms /
# Account Deletion links (App Store / Play Store + in-app). Local preview:
# http://localhost:8080 after `python3 -m http.server 8080` in stride-compliance.
EXPO_PUBLIC_COMPLIANCE_BASE_URL=https://compliance.musafir249.com

# Must match stride-api TRIP_CREATE_CREDITS (shown on the publish button).
EXPO_PUBLIC_TRIP_CREATE_CREDITS=10

# Must match stride-api BID_OFFER_CREDITS (shown on bid / offer submit).
EXPO_PUBLIC_BID_OFFER_CREDITS=5
